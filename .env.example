# Public URL of the app, used in links inside texts and emails.
# Leave unset in development; the request's host is used instead.
APP_URL=

# Where the SQLite file lives. Defaults to ./data/gather.db
DATABASE_PATH=

# Text message + WhatsApp updates (https://www.twilio.com). Without these,
# messages are written to the server console and marked "logged".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# Email updates (https://sendgrid.com).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
