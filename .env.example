# Public URL of the app, used in links inside texts and emails.
# Leave unset in development; the request's host is used instead.
APP_URL=

# Database. Leave both unset in development to use a local file (./data/doorlist.db).
# In production, create a database at https://turso.tech and paste its URL and token:
#   turso db show doorlist --url
#   turso db tokens create doorlist
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Email updates (https://resend.com). Without these, emails are written to the
# server log and marked "logged". EMAIL_FROM must use a domain verified in Resend,
# e.g. Doorlist <invites@yourdomain.com>
RESEND_API_KEY=
EMAIL_FROM=

# Text message + WhatsApp updates (https://www.twilio.com). Optional and paid.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
